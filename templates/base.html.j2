<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<meta name="theme-color" content="{{ theme_color }}">
<link rel="icon" type="image/svg+xml" href="{{ favicon }}">
{% if languages|length > 1 %}
{% for code in languages %}
<link rel="alternate" hreflang="{{ code }}" href="{{ origin }}{{ urls[code] }}">
{% endfor %}
<link rel="alternate" hreflang="x-default" href="{{ origin }}{{ urls['en'] }}">
{% endif %}
{% if origin %}
<link rel="canonical" href="{{ origin }}{{ urls[lang] }}">
{% endif %}
<link rel="preload" href="{{ root }}/assets/fonts/noto-sans-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="{{ root }}/assets/fonts/noto-serif-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="{{ root }}/assets/site.css">
</head>
<body>
<a class="skip" href="#main">{{ t("skip_to_content") }}</a>
{% if sample_data %}
<div class="sample" role="note"><p class="wrap"><strong>{{ t("sample_banner_lead") }}</strong> {{ t("sample_banner") }}</p></div>
{% endif %}
<header class="top">
 <div class="wrap bar">
  <a class="brand" href="{{ home_url }}">
   <img src="{{ logo }}" alt="" width="48" height="48">
   <span class="name"><strong>{{ t("site_name") }}</strong>{{ t("site_tagline") }}</span>
  </a>
{% if languages|length > 1 %}
  <div class="lang" role="group" aria-label="{{ tp('lang_switch_label') }}">
{% for code in languages %}
{% if code == lang %}
   <span aria-current="true" lang="{{ code }}">{{ t("lang_name_" ~ code) }}</span>
{% else %}
   <a href="{{ urls[code] }}" hreflang="{{ code }}" lang="{{ code }}">{{ t("lang_name_" ~ code) }}</a>
{% endif %}
{% endfor %}
  </div>
{% endif %}
 </div>
 <nav class="sub" aria-label="{{ tp('nav_label') }}"><div class="wrap">
{% for item in nav %}
  <a href="{{ item.url }}"{% if item.current %} aria-current="page"{% endif %}>{{ t(item.key) }}</a>
{% endfor %}
 </div></nav>
</header>

<main id="main"><div class="wrap">
{% block main %}{% endblock %}
</div></main>

<footer><div class="wrap">
 <p>{{ t("footer_text", contact=contact, license=license_name)|linkify }}</p>
 <p class="updated">{{ t("updated_on", date=updated) }}</p>
</div></footer>
</body>
</html>
